root = true

[*]
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4

# UTF-8 com BOM: o PowerShell 7 lê sem ele, mas o BOM mantém os acentos se o
# script for aberto no Windows PowerShell 5.1.
[*.{ps1,psm1}]
charset = utf-8-bom

# O editor do VBA importa .bas como Windows-1252. Salvo em UTF-8, "não" vira "nÃ£o".
[*.bas]
charset = latin1

[*.{md,json,yml,yaml}]
charset = utf-8
indent_size = 2
